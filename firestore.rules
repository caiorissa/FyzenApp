rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return logado() && request.auth.uid == uid;
    }

    function isAdmin() {
      return logado() &&
             (request.auth.token.get('admin', false) == true ||
              request.auth.token.get('email', '') == 'caiorissa@gmail.com' ||
              request.auth.token.get('email', '') == 'caiorissasilveiraa@gmail.com');
    }

    function ownsExistingDocument() {
      return logado() && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return logado() && request.resource.data.get('ownerUid', '') == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(uid);
    }

    match /planos/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(uid);
    }

    match /progresso/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(uid);
    }

    match /metas/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(uid);
    }

    match /historicoTreino/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(uid);

      match /registros/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isOwner(uid);
      }
    }

    // Fyzen 2.0: sessionId is client-generated and reused, so writes are idempotent.
    // userId is checked against the path to prevent cross-account document injection.
    match /workoutSessions/{uid}/sessions/{sessionId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.userId == uid;
      allow update: if isOwner(uid) &&
                    resource.data.userId == uid &&
                    request.resource.data.userId == uid;
      allow delete: if isOwner(uid);
    }

    match /analyticsSemana/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create: if isOwner(uid) && request.resource.data.get('uid', '') == uid;
      allow update: if isOwner(uid) && resource.data.get('uid', '') == uid && request.resource.data.get('uid', '') == uid;
      allow delete: if isOwner(uid) && resource.data.get('uid', '') == uid;
    }

    match /planosCollection/{docId} {
      allow get: if isAdmin() || (logado() && ownsExistingDocument());
      allow list: if isAdmin();
      allow create: if logado() && ownsIncomingDocument();
      allow update: if logado() && ownsExistingDocument() && ownsIncomingDocument();
      allow delete: if logado() && ownsExistingDocument();
    }

    match /planHistory/{docId} {
      allow get: if isAdmin() || (logado() && ownsExistingDocument());
      allow list: if isAdmin();
      allow create: if logado() && ownsIncomingDocument();
      allow update: if logado() && ownsExistingDocument() && ownsIncomingDocument();
      allow delete: if logado() && ownsExistingDocument();
    }

    match /nutrition/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(uid);

      match /days/{diaId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isOwner(uid);
      }
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if logado();
      allow write: if isAdmin();
    }
  }
}
